VITE_AZURE_CLIENT_ID=your-azure-ad-app-client-id


# AI model pricing store (server side). Default: local file ./data/ai-model-pricing.json
# PRICING_FILE=./data/ai-model-pricing.json
# Use blob storage instead (managed identity in Azure, 'az login' locally):
# PRICING_BLOB_URL=https://<account>.blob.core.windows.net/<container>/ai-model-pricing.json
# PRICING_EDITORS=admin@contoso.com

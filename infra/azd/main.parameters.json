{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "targetPort": {
      "value": 8080
    },
    "pricingEditors": {
      "value": "${PRICING_EDITORS}"
    },
    "authClientId": {
      "value": "${VITE_AZURE_CLIENT_ID}"
    },
    "authClientSecretUri": {
      "value": "${AUTH_CLIENT_SECRET_URI}"
    }
  }
}
